@model FollowUpFormViewModel
@{
    var canAssign = User.IsInRole(AppRoles.Admin) || User.IsInRole(AppRoles.Manager);
    var minDate = DateTime.Today.ToString("yyyy-MM-ddT00:00");
}

<div asp-validation-summary="ModelOnly" class="text-danger mb-3" role="alert"></div>

<div class="card bg-light border-0 mb-3">
    <div class="card-body">
        <div class="fw-semibold mb-2">
            Related to <span class="text-danger">*</span>
            <small class="text-muted fw-normal">(choose at least one)</small>
        </div>
        <div class="row g-3">
            <div class="col-md-4">
                <label asp-for="CustomerId" class="form-label"></label>
                <select asp-for="CustomerId" class="form-select" asp-items="Model.Customers">
                    <option value="">-- None --</option>
                </select>
                <span asp-validation-for="CustomerId" class="text-danger small"></span>
            </div>
            <div class="col-md-4">
                <label asp-for="LeadId" class="form-label"></label>
                <select asp-for="LeadId" class="form-select" asp-items="Model.Leads">
                    <option value="">-- None --</option>
                </select>
                <span asp-validation-for="LeadId" class="text-danger small"></span>
            </div>
            <div class="col-md-4">
                <label asp-for="OpportunityId" class="form-label"></label>
                <select asp-for="OpportunityId" class="form-select" asp-items="Model.Opportunities">
                    <option value="">-- None --</option>
                </select>
                <span asp-validation-for="OpportunityId" class="text-danger small"></span>
            </div>
        </div>
    </div>
</div>

<div class="row g-3">
    <div class="col-md-8">
        <label asp-for="Subject" class="form-label"></label> <span class="text-danger">*</span>
        <input asp-for="Subject" class="form-control" maxlength="150" placeholder="e.g. Discuss pricing proposal" />
        <span asp-validation-for="Subject" class="text-danger small"></span>
    </div>

    <div class="col-md-4">
        <label asp-for="FollowUpType" class="form-label"></label> <span class="text-danger">*</span>
        <select asp-for="FollowUpType" class="form-select" asp-items="Html.GetEnumSelectList<FollowUpType>()"></select>
        <span asp-validation-for="FollowUpType" class="text-danger small"></span>
    </div>

    <div class="col-md-4">
        <label asp-for="FollowUpDate" class="form-label"></label> <span class="text-danger">*</span>
        <input asp-for="FollowUpDate" class="form-control" type="datetime-local" min="@minDate" />
        <span asp-validation-for="FollowUpDate" class="text-danger small"></span>
    </div>

    <div class="col-md-4">
        <label asp-for="Status" class="form-label"></label> <span class="text-danger">*</span>
        <select asp-for="Status" class="form-select" asp-items="Model.AllowedStatuses"></select>
        <span asp-validation-for="Status" class="text-danger small"></span>
    </div>

    <div class="col-md-4">
        <label asp-for="AssignedTo" class="form-label"></label>
        @if (canAssign)
        {
            <select asp-for="AssignedTo" class="form-select" asp-items="Model.SalesExecutives">
                <option value="">-- Owner of related record --</option>
            </select>
            <span asp-validation-for="AssignedTo" class="text-danger small"></span>
        }
        else
        {
            <input class="form-control" value="You (auto-assigned)" disabled />
        }
    </div>

    <div class="col-12">
        <label asp-for="Remarks" class="form-label"></label>
        <textarea asp-for="Remarks" class="form-control" rows="3" maxlength="1000"></textarea>
        <span asp-validation-for="Remarks" class="text-danger small"></span>
    </div>
</div>
