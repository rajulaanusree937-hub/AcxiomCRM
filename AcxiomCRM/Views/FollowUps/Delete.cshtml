@model FollowUp
@{
    ViewData["Title"] = "Delete Follow-Up";
}

<h1 class="h3 mb-3 text-danger"><i class="bi bi-exclamation-triangle me-2"></i>Delete Follow-Up</h1>

<div class="card shadow-sm border-danger">
    <div class="card-body">
        <p class="mb-3">Are you sure you want to delete this follow-up?</p>
        <dl class="row mb-4">
            <dt class="col-sm-3">Subject</dt>
            <dd class="col-sm-9">@Model.Subject</dd>
            <dt class="col-sm-3">Date</dt>
            <dd class="col-sm-9">@Model.FollowUpDate.ToString("dd MMM yyyy, hh:mm tt")</dd>
            <dt class="col-sm-3">Status</dt>
            <dd class="col-sm-9">@Model.Status</dd>
            <dt class="col-sm-3">Related</dt>
            <dd class="col-sm-9">@(Model.Customer?.CustomerName ?? Model.Lead?.LeadName ?? Model.Opportunity?.OpportunityName ?? "—")</dd>
        </dl>
        <form asp-action="Delete" asp-route-id="@Model.FollowUpId" method="post"
              data-confirm="Delete follow-up '@Model.Subject'?">
            <button type="submit" class="btn btn-danger"><i class="bi bi-trash"></i> Yes, delete</button>
            <a asp-action="Details" asp-route-id="@Model.FollowUpId" class="btn btn-outline-secondary">Cancel</a>
        </form>
    </div>
</div>