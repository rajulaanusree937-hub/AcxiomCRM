@{
    ViewData["Title"] = "Dashboard";
}

<div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-2">
    <div>
        <h1 class="h3 mb-0">Dashboard</h1>
        <small class="text-muted">Sales overview for your authorized scope</small>
    </div>

    @* Date filter (4.3) — wired up in Step 12 *@
    <div class="btn-group" role="group" aria-label="Date filter">
        <button type="button" class="btn btn-outline-primary btn-sm">Today</button>
        <button type="button" class="btn btn-outline-primary btn-sm">This Week</button>
        <button type="button" class="btn btn-outline-primary btn-sm active">This Month</button>
        <button type="button" class="btn btn-outline-primary btn-sm">Custom Range</button>
    </div>
</div>

@* ---------- KPI cards (17.11) ---------- *@
<div class="row g-3 mb-4">
    @{
        var cards = new[]
        {
            new { Title = "Total Customers",      Icon = "bi-people",          Color = "primary"   },
            new { Title = "Total Leads",          Icon = "bi-person-plus",     Color = "info"      },
            new { Title = "Open Leads",           Icon = "bi-hourglass-split", Color = "warning"   },
            new { Title = "Total Opportunities",  Icon = "bi-briefcase",       Color = "secondary" },
            new { Title = "Open Opportunities",   Icon = "bi-graph-up-arrow",  Color = "primary"   },
            new { Title = "Won Opportunities",    Icon = "bi-trophy",          Color = "success"   },
            new { Title = "Lost Opportunities",   Icon = "bi-x-circle",        Color = "danger"    },
            new { Title = "Total Pipeline Value", Icon = "bi-currency-rupee",  Color = "dark"      }
        };
    }

    @foreach (var card in cards)
    {
        <div class="col-6 col-md-4 col-xl-3">
            <div class="card shadow-sm h-100 border-0 border-start border-4 border-@card.Color">
                <div class="card-body d-flex justify-content-between align-items-center">
                    <div>
                        <div class="text-muted small">@card.Title</div>
                        <div class="fs-4 fw-semibold">—</div>
                    </div>
                    <i class="bi @card.Icon fs-2 text-@card.Color opacity-75"></i>
                </div>
            </div>
        </div>
    }
</div>

@* ---------- Charts (17.12) — Chart.js added in Step 12 ---------- *@
<div class="row g-3">
    <div class="col-lg-4">
        <div class="card shadow-sm h-100">
            <div class="card-header bg-white fw-semibold">Lead Status</div>
            <div class="card-body d-flex align-items-center justify-content-center text-muted" style="min-height:250px">
                Chart coming in Step 12
            </div>
        </div>
    </div>
    <div class="col-lg-4">
        <div class="card shadow-sm h-100">
            <div class="card-header bg-white fw-semibold">Opportunity Pipeline</div>
            <div class="card-body d-flex align-items-center justify-content-center text-muted" style="min-height:250px">
                Chart coming in Step 12
            </div>
        </div>
    </div>
    <div class="col-lg-4">
        <div class="card shadow-sm h-100">
            <div class="card-header bg-white fw-semibold">Monthly Sales</div>
            <div class="card-body d-flex align-items-center justify-content-center text-muted" style="min-height:250px">
                Chart coming in Step 12
            </div>
        </div>
    </div>
</div>