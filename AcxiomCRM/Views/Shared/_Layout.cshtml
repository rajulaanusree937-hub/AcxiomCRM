@{
    var isSignedIn = User.Identity?.IsAuthenticated == true;
    var isAdmin = User.IsInRole(AppRoles.Admin);
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString();

    string Active(string controller) =>
        string.Equals(currentController, controller, StringComparison.OrdinalIgnoreCase) ? "active fw-semibold" : "";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - AcxiomCRM</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/AcxiomCRM.styles.css" asp-append-version="true" />
</head>
<body class="bg-light d-flex flex-column min-vh-100">
    <header>
        <nav class="navbar navbar-expand-lg navbar-light bg-white border-bottom shadow-sm mb-4">
            <div class="container-xl">
                <a class="navbar-brand fw-bold text-primary"
                   asp-area="" asp-controller="@(isSignedIn ? "Dashboard" : "Home")" asp-action="Index">
                    <i class="bi bi-diagram-3-fill me-1"></i>AcxiomCRM
                </a>

                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNav"
                        aria-controls="mainNav" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse" id="mainNav">
                    <ul class="navbar-nav me-auto mb-2 mb-lg-0">
                        @if (isSignedIn)
                        {
                            <li class="nav-item">
                                <a class="nav-link @Active("Dashboard")" asp-area="" asp-controller="Dashboard" asp-action="Index">
                                    <i class="bi bi-speedometer2 me-1"></i>Dashboard
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link @Active("Customers")" asp-area="" asp-controller="Customers" asp-action="Index">
                                    <i class="bi bi-people me-1"></i>Customers
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link @Active("Leads")" asp-area="" asp-controller="Leads" asp-action="Index">
                                    <i class="bi bi-person-plus me-1"></i>Leads
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link @Active("Opportunities")" asp-area="" asp-controller="Opportunities" asp-action="Index">
                                    <i class="bi bi-briefcase me-1"></i>Opportunities
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link @Active("FollowUps")" asp-area="" asp-controller="FollowUps" asp-action="Index">
                                    <i class="bi bi-calendar-check me-1"></i>Follow-Ups
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link @Active("Activities")" asp-area="" asp-controller="Activities" asp-action="Index">
                                    <i class="bi bi-telephone me-1"></i>Activities
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link @Active("Reports")" asp-area="" asp-controller="Reports" asp-action="Index">
                                    <i class="bi bi-bar-chart me-1"></i>Reports
                                </a>
                            </li>

                            @if (isAdmin)
                            {
                                <li class="nav-item dropdown">
                                    <a class="nav-link dropdown-toggle @Active("Users") @Active("AuditLogs")" href="#"
                                       role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                        <i class="bi bi-shield-lock me-1"></i>Administration
                                    </a>
                                    <ul class="dropdown-menu">
                                        <li>
                                            <a class="dropdown-item" asp-area="" asp-controller="Users" asp-action="Index">
                                                <i class="bi bi-person-gear me-1"></i>Users &amp; Roles
                                            </a>
                                        </li>
                                        <li>
                                            <a class="dropdown-item" asp-area="" asp-controller="AuditLogs" asp-action="Index">
                                                <i class="bi bi-journal-text me-1"></i>Audit Log
                                            </a>
                                        </li>
                                    </ul>
                                </li>
                            }
                        }
                    </ul>
                    <partial name="_LoginPartial" />
                </div>
            </div>
        </nav>
    </header>

    <div class="container-xl flex-grow-1">
        <main role="main" class="pb-4">
            <partial name="_Alerts" />
            @RenderBody()
        </main>
    </div>

    <footer class="border-top bg-white text-muted py-3 mt-auto">
        <div class="container-xl d-flex justify-content-between small">
            <span>&copy; @DateTime.Now.Year AcxiomCRM</span>
            <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>