@model Activity
@{
    ViewData["Title"] = Model.Subject;
}

<div class="d-flex flex-wrap justify-content-between align-items-center mb-3 gap-2">
    <div>
        <h1 class="h3 mb-0">@Model.Subject</h1>
        <span class="badge bg-light text-dark border">@Model.ActivityType</span>
        <span class="badge bg-primary">@Model.Status</span>
    </div>
    <div class="d-flex gap-2">
        <a asp-action="Edit" asp-route-id="@Model.ActivityId" class="btn btn-primary btn-sm"><i class="bi bi-pencil"></i> Edit</a>
        <a asp-action="Delete" asp-route-id="@Model.ActivityId" class="btn btn-outline-danger btn-sm"><i class="bi bi-trash"></i> Delete</a>
        <a asp-action="Index" class="btn btn-outline-secondary btn-sm"><i class="bi bi-arrow-left"></i> Back</a>
    </div>
</div>

<div class="card shadow-sm">
    <div class="card-body">
        <dl class="row mb-0">
            <dt class="col-sm-3">Date &amp; Time</dt>
            <dd class="col-sm-9">@Model.ActivityDate.ToString("dddd, dd MMM yyyy, hh:mm tt")</dd>

            <dt class="col-sm-3">Customer</dt>
            <dd class="col-sm-9">
                @if (Model.Customer != null)
                {
                    <a asp-controller="Customers" asp-action="Details" asp-route-id="@Model.CustomerId">@Model.Customer.CustomerName</a>
                }
                else
                {

                    <span>—</span>
                }
            </dd>

            <dt class="col-sm-3">Lead</dt>
            <dd class="col-sm-9">
                @if (Model.Lead != null)
                {
                    <a asp-controller="Leads" asp-action="Details" asp-route-id="@Model.LeadId">@Model.Lead.LeadName</a>
                }
                else
                {

                    <span>—</span>
                }
            </dd>

            <dt class="col-sm-3">Assigned To</dt>
            <dd class="col-sm-9">@(ViewBag.AssignedToName ?? "Unassigned")</dd>

            <dt class="col-sm-3">Logged</dt>
            <dd class="col-sm-9">@Model.CreatedDate.ToLocalTime().ToString("dd MMM yyyy, hh:mm tt")</dd>

            <dt class="col-sm-3">Description</dt>
            <dd class="col-sm-9 mb-0">@(Model.Description ?? "—")</dd>
        </dl>
    </div>
</div>