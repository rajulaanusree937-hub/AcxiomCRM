@model Opportunity
@{
    ViewData["Title"] = "Delete Opportunity";
}

<h1 class="h3 mb-3 text-danger"><i class="bi bi-exclamation-triangle me-2"></i>Delete Opportunity</h1>

<div class="card shadow-sm border-danger">
    <div class="card-body">
        <p class="mb-3">Are you sure you want to delete this opportunity? This cannot be undone.</p>
        <dl class="row mb-4">
            <dt class="col-sm-3">Name</dt>
            <dd class="col-sm-9">@Model.OpportunityName</dd>
            <dt class="col-sm-3">Customer</dt>
            <dd class="col-sm-9">@Model.Customer?.CustomerName</dd>
            <dt class="col-sm-3">Stage</dt>
            <dd class="col-sm-9">@Model.Stage</dd>
            <dt class="col-sm-3">Amount</dt>
            <dd class="col-sm-9">₹@Model.Amount.ToString("N2")</dd>
        </dl>
        <form asp-action="Delete" asp-route-id="@Model.OpportunityId" method="post"
              data-confirm="Delete opportunity '@Model.OpportunityName'?">
            <button type="submit" class="btn btn-danger"><i class="bi bi-trash"></i> Yes, delete</button>
            <a asp-action="Details" asp-route-id="@Model.OpportunityId" class="btn btn-outline-secondary">Cancel</a>
        </form>
    </div>
</div>