@model OpportunityFormViewModel
@{
    var canAssign = User.IsInRole(AppRoles.Admin) || User.IsInRole(AppRoles.Manager);
    var today = DateTime.Today.ToString("yyyy-MM-dd");
}

<div asp-validation-summary="ModelOnly" class="text-danger mb-3" role="alert"></div>

<div class="row g-3">
    <div class="col-md-8">
        <label asp-for="OpportunityName" class="form-label"></label> <span class="text-danger">*</span>
        <input asp-for="OpportunityName" class="form-control" maxlength="150" placeholder="e.g. Infosys - CRM rollout" />
        <span asp-validation-for="OpportunityName" class="text-danger small"></span>
    </div>

    <div class="col-md-4">
        <label asp-for="Stage" class="form-label"></label> <span class="text-danger">*</span>
        <select asp-for="Stage" class="form-select" asp-items="Model.AllowedStages"></select>
        <span asp-validation-for="Stage" class="text-danger small"></span>
    </div>

    <div class="col-md-6">
        <label asp-for="CustomerId" class="form-label"></label> <span class="text-danger">*</span>
        <select asp-for="CustomerId" class="form-select" asp-items="Model.Customers">
            <option value="">-- Select customer --</option>
        </select>
        <span asp-validation-for="CustomerId" class="text-danger small"></span>
    </div>

    <div class="col-md-6">
        <label asp-for="LeadId" class="form-label"></label>
        <select asp-for="LeadId" class="form-select" asp-items="Model.Leads">
            <option value="">-- None --</option>
        </select>
        <span asp-validation-for="LeadId" class="text-danger small"></span>
    </div>

    <div class="col-md-4">
        <label asp-for="Amount" class="form-label"></label> <span class="text-danger">*</span>
        <input asp-for="Amount" class="form-control" type="number" step="0.01" min="0" id="amount" />
        <span asp-validation-for="Amount" class="text-danger small"></span>
    </div>

    <div class="col-md-4">
        <label asp-for="Probability" class="form-label"></label> <span class="text-danger">*</span>
        <input asp-for="Probability" class="form-control" type="number" min="0" max="100" id="probability" />
        <span asp-validation-for="Probability" class="text-danger small"></span>
    </div>

    <div class="col-md-4">
        <label asp-for="ExpectedCloseDate" class="form-label"></label> <span class="text-danger">*</span>
        <input asp-for="ExpectedCloseDate" class="form-control" type="date" min="@today" />
        <span asp-validation-for="ExpectedCloseDate" class="text-danger small"></span>
    </div>

    <div class="col-12">
        <div class="alert alert-light border py-2 mb-0">
            <i class="bi bi-calculator me-1"></i>
            Weighted value (Amount × Probability ÷ 100): <strong>₹<span id="weighted">0.00</span></strong>
        </div>
    </div>

    <div class="col-md-6">
        <label asp-for="Source" class="form-label"></label>
        <select asp-for="Source" class="form-select" asp-items="Html.GetEnumSelectList<LeadSource>()">
            <option value="">-- Not specified --</option>
        </select>
    </div>

    <div class="col-md-6">
        <label asp-for="AssignedTo" class="form-label"></label>
        @if (canAssign)
        {
            <select asp-for="AssignedTo" class="form-select" asp-items="Model.SalesExecutives">
                <option value="">-- Customer's owner --</option>
            </select>
            <span asp-validation-for="AssignedTo" class="text-danger small"></span>
        }
        else
        {
            <input class="form-control" value="You (auto-assigned)" disabled />
        }
    </div>

    <div class="col-12">
        <label asp-for="Notes" class="form-label"></label>
        <textarea asp-for="Notes" class="form-control" rows="3" maxlength="1000"></textarea>
        <span asp-validation-for="Notes" class="text-danger small"></span>
    </div>
</div>