@model OpportunityFormViewModel
@{
    ViewData["Title"] = "Edit Opportunity";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0"><i class="bi bi-pencil-square me-2"></i>Edit Opportunity</h1>
    <a asp-action="Details" asp-route-id="@Model.OpportunityId" class="btn btn-outline-secondary btn-sm">
        <i class="bi bi-arrow-left"></i> Back to details
    </a>
</div>

<div class="card shadow-sm">
    <div class="card-body">
        <form asp-action="Edit" asp-route-id="@Model.OpportunityId" method="post" novalidate>
            <input type="hidden" asp-for="OpportunityId" />
            <partial name="_OpportunityForm" model="Model" />
            <div class="mt-4 d-flex gap-2">
                <button type="submit" class="btn btn-primary"><i class="bi bi-check-lg"></i> Save changes</button>
                <a asp-action="Details" asp-route-id="@Model.OpportunityId" class="btn btn-outline-secondary">Cancel</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        (function () {
            const a = document.getElementById('amount'), p = document.getElementById('probability'), w = document.getElementById('weighted');
            const calc = () => w.textContent = ((parseFloat(a.value) || 0) * (parseFloat(p.value) || 0) / 100).toFixed(2);
            a.addEventListener('input', calc); p.addEventListener('input', calc); calc();
        })();
    </script>
}