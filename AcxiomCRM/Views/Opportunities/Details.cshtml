@model Opportunity
@{
    ViewData["Title"] = Model.OpportunityName;
    var isOpen = Model.Status == OpportunityStatus.Open;
    var weighted = Model.Amount * Model.Probability / 100m;
}

<div class="d-flex flex-wrap justify-content-between align-items-center mb-3 gap-2">
    <div>
        <h1 class="h3 mb-0">@Model.OpportunityName</h1>
        <span class="badge bg-primary">@Model.Stage</span>
        <span class="badge @(isOpen ? "bg-success" : "bg-secondary")">@Model.Status</span>
    </div>
    <div class="d-flex flex-wrap gap-2">
        @if (isOpen)
        {
            <form asp-action="Close" asp-route-id="@Model.OpportunityId" asp-route-won="true" method="post"
                  data-confirm="Mark this opportunity as WON?">
                <button type="submit" class="btn btn-success btn-sm"><i class="bi bi-trophy"></i> Mark Won</button>
            </form>
            <form asp-action="Close" asp-route-id="@Model.OpportunityId" asp-route-won="false" method="post"
                  data-confirm="Mark this opportunity as LOST?">
                <button type="submit" class="btn btn-outline-danger btn-sm"><i class="bi bi-x-circle"></i> Mark Lost</button>
            </form>
            <a asp-action="Edit" asp-route-id="@Model.OpportunityId" class="btn btn-primary btn-sm"><i class="bi bi-pencil"></i> Edit</a>
        }
        <a asp-controller="FollowUps" asp-action="Create" asp-route-opportunityId="@Model.OpportunityId" class="btn btn-outline-primary btn-sm">
            <i class="bi bi-calendar-plus"></i> Schedule Follow-Up
        </a>
        <a asp-action="Delete" asp-route-id="@Model.OpportunityId" class="btn btn-outline-danger btn-sm"><i class="bi bi-trash"></i></a>
        <a asp-action="Index" class="btn btn-outline-secondary btn-sm"><i class="bi bi-arrow-left"></i> Back</a>
    </div>
</div>

<div class="row g-3">
    <div class="col-lg-5">
        <div class="card shadow-sm h-100">
            <div class="card-header bg-white fw-semibold">Opportunity Details</div>
            <div class="card-body">
                <dl class="mb-0">
                    <dt class="small text-muted">Customer</dt>
                    <dd><a asp-controller="Customers" asp-action="Details" asp-route-id="@Model.CustomerId">@Model.Customer?.CustomerName</a></dd>
                    <dt class="small text-muted">Source Lead</dt>
                    <dd>
                        @if (Model.Lead != null)
                        {
                            <a asp-controller="Leads" asp-action="Details" asp-route-id="@Model.LeadId">@Model.Lead.LeadName</a>
                        }
                        else
                        {

                            <span>—</span>
                        }
                    </dd>
                    <dt class="small text-muted">Amount</dt>
                    <dd>₹@Model.Amount.ToString("N2")</dd>
                    <dt class="small text-muted">Probability</dt>
                    <dd>@Model.Probability%</dd>
                    <dt class="small text-muted">Weighted Value</dt>
                    <dd class="fw-semibold">₹@weighted.ToString("N2")</dd>
                    <dt class="small text-muted">Expected Close Date</dt>
                    <dd>@Model.ExpectedCloseDate.ToString("dd MMM yyyy")</dd>
                    <dt class="small text-muted">Source</dt>
                    <dd>@(Model.Source?.ToString() ?? "—")</dd>
                    <dt class="small text-muted">Owner</dt>
                    <dd>@(ViewBag.AssignedToName ?? "Unassigned")</dd>
                    <dt class="small text-muted">Created</dt>
                    <dd>@Model.CreatedDate.ToLocalTime().ToString("dd MMM yyyy")</dd>
                    <dt class="small text-muted">Notes</dt>
                    <dd class="mb-0">@(Model.Notes ?? "—")</dd>
                </dl>
            </div>
        </div>
    </div>

    <div class="col-lg-7">
        <div class="card shadow-sm">
            <div class="card-header bg-white fw-semibold">Follow-Ups (@Model.FollowUps.Count)</div>
            @if (Model.FollowUps.Any())
            {
                <table class="table table-sm mb-0">
                    <thead class="table-light"><tr><th>Date</th><th>Subject</th><th>Type</th><th>Status</th></tr></thead>
                    <tbody>
                        @foreach (var f in Model.FollowUps.OrderByDescending(f => f.FollowUpDate))
                        {
                            <tr>
                                <td>@f.FollowUpDate.ToString("dd MMM yyyy")</td>
                                <td><a asp-controller="FollowUps" asp-action="Details" asp-route-id="@f.FollowUpId">@f.Subject</a></td>
                                <td>@f.FollowUpType</td>
                                <td>@f.Status</td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
            else
            {

                <div class="card-body text-muted small">No follow-ups yet.</div>
            }
        </div>
    </div>
</div>