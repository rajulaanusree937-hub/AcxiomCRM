@model Customer
@{
    ViewData["Title"] = "Delete Customer";
}

<h1 class="h3 mb-3 text-danger"><i class="bi bi-exclamation-triangle me-2"></i>Delete Customer</h1>

<div class="card shadow-sm border-danger">
    <div class="card-body">
        <p class="mb-3">Are you sure you want to delete this customer? This cannot be undone.</p>

        <dl class="row mb-4">
            <dt class="col-sm-3">Code</dt>
            <dd class="col-sm-9">@Model.CustomerCode</dd>
            <dt class="col-sm-3">Name</dt>
            <dd class="col-sm-9">@Model.CustomerName</dd>
            <dt class="col-sm-3">Email</dt>
            <dd class="col-sm-9">@Model.Email</dd>
            <dt class="col-sm-3">Phone</dt>
            <dd class="col-sm-9">@Model.Phone</dd>
            <dt class="col-sm-3">Company</dt>
            <dd class="col-sm-9">@(Model.CompanyName ?? "—")</dd>
            <dt class="col-sm-3">Assigned To</dt>
            <dd class="col-sm-9">@(ViewBag.AssignedToName ?? "Unassigned")</dd>
        </dl>

        <form asp-action="Delete" asp-route-id="@Model.CustomerId" method="post"
              data-confirm="Delete customer '@Model.CustomerName'? This cannot be undone.">
            <button type="submit" class="btn btn-danger"><i class="bi bi-trash"></i> Yes, delete</button>
            <a asp-action="Details" asp-route-id="@Model.CustomerId" class="btn btn-outline-secondary">Cancel</a>
        </form>
    </div>
</div>