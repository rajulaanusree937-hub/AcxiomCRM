@model CustomerFormViewModel
@{
    var canAssign = User.IsInRole(AppRoles.Admin) || User.IsInRole(AppRoles.Manager);
}

<div asp-validation-summary="ModelOnly" class="text-danger mb-3" role="alert"></div>

<div class="row g-3">
    <div class="col-md-6">
        <label asp-for="CustomerName" class="form-label"></label> <span class="text-danger">*</span>
        <input asp-for="CustomerName" class="form-control" maxlength="100" />
        <span asp-validation-for="CustomerName" class="text-danger small"></span>
    </div>

    <div class="col-md-6">
        <label asp-for="Status" class="form-label"></label> <span class="text-danger">*</span>
        <select asp-for="Status" class="form-select" asp-items="Html.GetEnumSelectList<CustomerStatus>()"></select>
        <span asp-validation-for="Status" class="text-danger small"></span>
    </div>

    <div class="col-md-6">
        <label asp-for="Email" class="form-label"></label> <span class="text-danger">*</span>
        <input asp-for="Email" class="form-control" type="email" maxlength="150" placeholder="name@example.com" />
        <span asp-validation-for="Email" class="text-danger small"></span>
    </div>

    <div class="col-md-6">
        <label asp-for="Phone" class="form-label"></label> <span class="text-danger">*</span>
        <input asp-for="Phone" class="form-control" type="tel" maxlength="10" placeholder="9876543210" />
        <span asp-validation-for="Phone" class="text-danger small"></span>
    </div>

    <div class="col-md-6">
        <label asp-for="CompanyName" class="form-label"></label>
        <input asp-for="CompanyName" class="form-control" maxlength="150" />
        <span asp-validation-for="CompanyName" class="text-danger small"></span>
    </div>

    <div class="col-md-6">
        <label asp-for="AssignedTo" class="form-label"></label>
        @if (canAssign)
        {
            <select asp-for="AssignedTo" class="form-select" asp-items="Model.SalesExecutives">
                <option value="">-- Unassigned --</option>
            </select>
            <span asp-validation-for="AssignedTo" class="text-danger small"></span>
        }
        else
        {
            <input class="form-control" value="You (auto-assigned)" disabled />
        }
    </div>

    <div class="col-12">
        <label asp-for="Address" class="form-label"></label>
        <input asp-for="Address" class="form-control" maxlength="250" />
        <span asp-validation-for="Address" class="text-danger small"></span>
    </div>

    <div class="col-md-6">
        <label asp-for="City" class="form-label"></label>
        <input asp-for="City" class="form-control" maxlength="100" />
        <span asp-validation-for="City" class="text-danger small"></span>
    </div>

    <div class="col-md-6">
        <label asp-for="State" class="form-label"></label>
        <input asp-for="State" class="form-control" maxlength="100" />
        <span asp-validation-for="State" class="text-danger small"></span>
    </div>

    <div class="col-12">
        <label asp-for="Notes" class="form-label"></label>
        <textarea asp-for="Notes" class="form-control" rows="3" maxlength="1000"></textarea>
        <span asp-validation-for="Notes" class="text-danger small"></span>
    </div>
</div>