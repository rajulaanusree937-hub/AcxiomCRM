@model Lead
@{
    ViewData["Title"] = "Delete Lead";
}

<h1 class="h3 mb-3 text-danger"><i class="bi bi-exclamation-triangle me-2"></i>Delete Lead</h1>

<div class="card shadow-sm border-danger">
    <div class="card-body">
        <p class="mb-3">Are you sure you want to delete this lead? This cannot be undone.</p>
        <dl class="row mb-4">
            <dt class="col-sm-3">Code</dt>
            <dd class="col-sm-9">@Model.LeadCode</dd>
            <dt class="col-sm-3">Name</dt>
            <dd class="col-sm-9">@Model.LeadName</dd>
            <dt class="col-sm-3">Company</dt>
            <dd class="col-sm-9">@(Model.CompanyName ?? "—")</dd>
            <dt class="col-sm-3">Status</dt>
            <dd class="col-sm-9">@Model.Status</dd>
            <dt class="col-sm-3">Assigned To</dt>
            <dd class="col-sm-9">@(ViewBag.AssignedToName ?? "Unassigned")</dd>
        </dl>
        <form asp-action="Delete" asp-route-id="@Model.LeadId" method="post"
              data-confirm="Delete lead '@Model.LeadName'? This cannot be undone.">
            <button type="submit" class="btn btn-danger"><i class="bi bi-trash"></i> Yes, delete</button>
            <a asp-action="Details" asp-route-id="@Model.LeadId" class="btn btn-outline-secondary">Cancel</a>
        </form>
    </div>
</div>