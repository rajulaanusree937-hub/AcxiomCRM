@model LeadConvertViewModel
@{
    ViewData["Title"] = "Convert Lead";
    var today = DateTime.Today.ToString("yyyy-MM-dd");
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h1 class="h3 mb-0"><i class="bi bi-arrow-repeat me-2"></i>Convert Lead</h1>
        <span class="badge bg-light text-dark border">@Model.LeadCode</span>
        <small class="text-muted ms-1">Qualified lead → Customer (+ Opportunity)</small>
    </div>
    <a asp-action="Details" asp-route-id="@Model.LeadId" class="btn btn-outline-secondary btn-sm">
        <i class="bi bi-arrow-left"></i> Back to lead
    </a>
</div>

<form asp-action="Convert" asp-route-id="@Model.LeadId" method="post" novalidate>
    <input type="hidden" asp-for="LeadId" />
    <input type="hidden" asp-for="LeadCode" />
    <div asp-validation-summary="ModelOnly" class="text-danger mb-3" role="alert"></div>

    <div class="row g-3">
        @* ---------- New customer ---------- *@
        <div class="col-lg-6">
            <div class="card shadow-sm h-100">
                <div class="card-header bg-white fw-semibold"><i class="bi bi-people me-1"></i> New Customer</div>
                <div class="card-body">
                    <div class="mb-3">
                        <label asp-for="CustomerName" class="form-label"></label> <span class="text-danger">*</span>
                        <input asp-for="CustomerName" class="form-control" maxlength="100" />
                        <span asp-validation-for="CustomerName" class="text-danger small"></span>
                    </div>
                    <div class="mb-3">
                        <label asp-for="Email" class="form-label"></label> <span class="text-danger">*</span>
                        <input asp-for="Email" class="form-control" type="email" maxlength="150" />
                        <span asp-validation-for="Email" class="text-danger small"></span>
                    </div>
                    <div class="mb-3">
                        <label asp-for="Phone" class="form-label"></label> <span class="text-danger">*</span>
                        <input asp-for="Phone" class="form-control" type="tel" maxlength="10" />
                        <span asp-validation-for="Phone" class="text-danger small"></span>
                    </div>
                    <div>
                        <label asp-for="CompanyName" class="form-label"></label>
                        <input asp-for="CompanyName" class="form-control" maxlength="150" />
                        <span asp-validation-for="CompanyName" class="text-danger small"></span>
                    </div>
                </div>
            </div>
        </div>

        @* ---------- Optional opportunity ---------- *@
        <div class="col-lg-6">
            <div class="card shadow-sm h-100">
                <div class="card-header bg-white">
                    <div class="form-check form-switch mb-0">
                        <input asp-for="CreateOpportunity" class="form-check-input" id="createOpp" />
                        <label asp-for="CreateOpportunity" class="form-check-label fw-semibold" for="createOpp"></label>
                    </div>
                </div>
                <div class="card-body" id="oppSection">
                    <div class="mb-3">
                        <label asp-for="OpportunityName" class="form-label"></label> <span class="text-danger">*</span>
                        <input asp-for="OpportunityName" class="form-control" maxlength="150" />
                        <span asp-validation-for="OpportunityName" class="text-danger small"></span>
                    </div>
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label asp-for="Amount" class="form-label"></label> <span class="text-danger">*</span>
                            <input asp-for="Amount" class="form-control" type="number" step="0.01" min="0.01" />
                            <span asp-validation-for="Amount" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="Probability" class="form-label"></label> <span class="text-danger">*</span>
                            <input asp-for="Probability" class="form-control" type="number" min="0" max="100" />
                            <span asp-validation-for="Probability" class="text-danger small"></span>
                        </div>
                    </div>
                    <div class="mt-3">
                        <label asp-for="ExpectedCloseDate" class="form-label"></label> <span class="text-danger">*</span>
                        <input asp-for="ExpectedCloseDate" class="form-control" type="date" min="@today" />
                        <span asp-validation-for="ExpectedCloseDate" class="text-danger small"></span>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="mt-4 d-flex gap-2">
        <button type="submit" class="btn btn-success"><i class="bi bi-check2-circle"></i> Convert lead</button>
        <a asp-action="Details" asp-route-id="@Model.LeadId" class="btn btn-outline-secondary">Cancel</a>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        // Show/hide the opportunity fields with the switch
        (function () {
            const toggle = document.getElementById('createOpp');
            const section = document.getElementById('oppSection');
            const sync = () => section.style.display = toggle.checked ? '' : 'none';
            toggle.addEventListener('change', sync);
            sync();
        })();
    </script>
}