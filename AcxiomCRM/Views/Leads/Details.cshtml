@model Lead
@{
    ViewData["Title"] = Model.LeadName;
}

<div class="d-flex flex-wrap justify-content-between align-items-center mb-3 gap-2">
    <div>
        <h1 class="h3 mb-0">@Model.LeadName</h1>
        <span class="badge bg-light text-dark border">@Model.LeadCode</span>
        <span class="badge bg-primary">@Model.Status</span>
        <span class="badge bg-light text-dark border">Priority: @Model.Priority</span>
    </div>
    <div class="d-flex gap-2">
        @if (Model.Status == LeadStatus.Qualified)
        {
            <a asp-action="Convert" asp-route-id="@Model.LeadId" class="btn btn-success btn-sm"><i class="bi bi-arrow-repeat"></i> Convert</a>
        }
        @if (Model.Status != LeadStatus.Converted)
        {
            <a asp-action="Edit" asp-route-id="@Model.LeadId" class="btn btn-primary btn-sm"><i class="bi bi-pencil"></i> Edit</a>
        }
        <a asp-action="Delete" asp-route-id="@Model.LeadId" class="btn btn-outline-danger btn-sm"><i class="bi bi-trash"></i> Delete</a>
        <a asp-action="Index" class="btn btn-outline-secondary btn-sm"><i class="bi bi-arrow-left"></i> Back</a>
    </div>
</div>

@if (Model.ConvertedCustomerId != null)
{
    <div class="alert alert-dark d-flex align-items-center">
        <i class="bi bi-check2-circle me-2"></i>
        This lead was converted.
        <a asp-controller="Customers" asp-action="Details" asp-route-id="@Model.ConvertedCustomerId" class="ms-2">View customer</a>
    </div>
}

<div class="row g-3">
    <div class="col-lg-4">
        <div class="card shadow-sm h-100">
            <div class="card-header bg-white fw-semibold">Lead Information</div>
            <div class="card-body">
                <dl class="mb-0">
                    <dt class="small text-muted">Company</dt>
                    <dd>@(Model.CompanyName ?? "—")</dd>
                    <dt class="small text-muted">Email</dt>
                    <dd>@(Model.Email ?? "—")</dd>
                    <dt class="small text-muted">Phone</dt>
                    <dd>@(Model.Phone ?? "—")</dd>
                    <dt class="small text-muted">Source</dt>
                    <dd>@Model.Source</dd>
                    <dt class="small text-muted">Expected Value</dt>
                    <dd>₹@Model.ExpectedValue.ToString("N2")</dd>
                    <dt class="small text-muted">Assigned To</dt>
                    <dd>@(ViewBag.AssignedToName ?? "Unassigned")</dd>
                    <dt class="small text-muted">Created</dt>
                    <dd>@Model.CreatedDate.ToLocalTime().ToString("dd MMM yyyy, hh:mm tt")</dd>
                    <dt class="small text-muted">Last Modified</dt>
                    <dd>@(Model.ModifiedDate?.ToLocalTime().ToString("dd MMM yyyy, hh:mm tt") ?? "—")</dd>
                    <dt class="small text-muted">Notes</dt>
                    <dd class="mb-0">@(Model.Notes ?? "—")</dd>
                </dl>
            </div>
        </div>
    </div>

    <div class="col-lg-8 d-flex flex-column gap-3">
        <div class="card shadow-sm">
            <div class="card-header bg-white fw-semibold">Opportunities (@Model.Opportunities.Count)</div>
            @if (Model.Opportunities.Any())
            {
                <table class="table table-sm mb-0">
                    <thead class="table-light"><tr><th>Name</th><th>Stage</th><th class="text-end">Amount</th><th>Expected Close</th></tr></thead>
                    <tbody>
                        @foreach (var o in Model.Opportunities)
                        {
                            <tr><td>@o.OpportunityName</td><td>@o.Stage</td><td class="text-end">₹@o.Amount.ToString("N2")</td><td>@o.ExpectedCloseDate.ToString("dd MMM yyyy")</td></tr>
                        }
                    </tbody>
                </table>
            }
            else
            {

                <div class="card-body text-muted small">No opportunities yet.</div>
            }
        </div>

        <div class="card shadow-sm">
            <div class="card-header bg-white fw-semibold">Follow-Ups (@Model.FollowUps.Count)</div>
            @if (Model.FollowUps.Any())
            {
                <table class="table table-sm mb-0">
                    <thead class="table-light"><tr><th>Date</th><th>Subject</th><th>Type</th><th>Status</th></tr></thead>
                    <tbody>
                        @foreach (var f in Model.FollowUps.OrderByDescending(f => f.FollowUpDate))
                        {
                            <tr><td>@f.FollowUpDate.ToString("dd MMM yyyy")</td><td>@f.Subject</td><td>@f.FollowUpType</td><td>@f.Status</td></tr>
                        }
                    </tbody>
                </table>
            }
            else
            {

                <div class="card-body text-muted small">No follow-ups yet.</div>
            }
        </div>

        <div class="card shadow-sm">
            <div class="card-header bg-white fw-semibold">Activities (@Model.Activities.Count)</div>
            @if (Model.Activities.Any())
            {
                <table class="table table-sm mb-0">
                    <thead class="table-light"><tr><th>Date</th><th>Type</th><th>Subject</th><th>Status</th></tr></thead>
                    <tbody>
                        @foreach (var a in Model.Activities.OrderByDescending(a => a.ActivityDate))
                        {
                            <tr><td>@a.ActivityDate.ToString("dd MMM yyyy")</td><td>@a.ActivityType</td><td>@a.Subject</td><td>@a.Status</td></tr>
                        }
                    </tbody>
                </table>
            }
            else
            {

                <div class="card-body text-muted small">No activities yet.</div>
            }
        </div>
    </div>
</div>