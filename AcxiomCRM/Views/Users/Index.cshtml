@model UserListViewModel
@{
    ViewData["Title"] = "Users & Roles";
}

<div class="d-flex flex-wrap justify-content-between align-items-center mb-3 gap-2">
    <div>
        <h1 class="h3 mb-0"><i class="bi bi-person-gear me-2"></i>Users &amp; Roles</h1>
        <small class="text-muted">@Model.Items.Count user(s)</small>
    </div>
    <div class="d-flex gap-2">
        <a asp-action="Roles" class="btn btn-outline-secondary"><i class="bi bi-shield-check"></i> Roles &amp; Permissions</a>
        <a asp-action="Create" class="btn btn-primary"><i class="bi bi-plus-lg"></i> New User</a>
    </div>
</div>

<form method="get" asp-action="Index" class="card card-body shadow-sm mb-3">
    <div class="row g-2 align-items-end">
        <div class="col-md-5">
            <label class="form-label small text-muted mb-1">Search</label>
            <input name="search" value="@Model.Search" class="form-control" placeholder="Name or email" />
        </div>
        <div class="col-md-3">
            <label class="form-label small text-muted mb-1">Role</label>
            <select name="role" class="form-select">
                <option value="">All roles</option>
                @foreach (var r in AppRoles.All)
                {
                    <option value="@r" selected="@(Model.Role == r)">@r</option>
                }
            </select>
        </div>
        <div class="col-md-2">
            <label class="form-label small text-muted mb-1">Status</label>
            <select name="status" class="form-select">
                <option value="">All</option>
                <option value="active" selected="@(Model.Status == "active")">Active</option>
                <option value="inactive" selected="@(Model.Status == "inactive")">Inactive</option>
                <option value="locked" selected="@(Model.Status == "locked")">Locked</option>
            </select>
        </div>
        <div class="col-md-2 d-flex gap-2">
            <button type="submit" class="btn btn-outline-primary flex-fill"><i class="bi bi-search"></i> Search</button>
            <a asp-action="Index" class="btn btn-outline-secondary" title="Clear"><i class="bi bi-x-lg"></i></a>
        </div>
    </div>
</form>

<div class="card shadow-sm">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th>Name</th>
                    <th>Email</th>
                    <th>Role</th>
                    <th>Status</th>
                    <th>Lockout</th>
                    <th>Created</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Items.Any())
                {
                    <tr><td colspan="7" class="text-center text-muted py-4">No users found.</td></tr>
                }
                @foreach (var u in Model.Items)
                {
                    <tr>
                        <td class="fw-semibold">@u.FullName</td>
                        <td>@u.Email</td>
                        <td><span class="badge @(u.Role == AppRoles.Admin ? "bg-dark" : u.Role == AppRoles.Manager ? "bg-primary" : "bg-info text-dark")">@(u.Role ?? "No role")</span></td>
                        <td><span class="badge @(u.IsActive ? "bg-success" : "bg-secondary")">@(u.IsActive ? "Active" : "Inactive")</span></td>
                        <td>
                            @if (u.IsLockedOut)
                            {
                                <span class="badge bg-danger"><i class="bi bi-lock"></i> Locked</span>
                            }
                            else
                            {
                                <span class="text-muted small">@u.FailedLoginCount failed</span>
                            }
                        </td>
                        <td>@u.CreatedDate.ToLocalTime().ToString("dd MMM yyyy")</td>
                        <td class="text-end text-nowrap">
                            <a asp-action="Edit" asp-route-id="@u.Id" class="btn btn-sm btn-outline-primary" title="Edit"><i class="bi bi-pencil"></i></a>
                            <a asp-action="ResetPassword" asp-route-id="@u.Id" class="btn btn-sm btn-outline-warning" title="Reset password"><i class="bi bi-key"></i></a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>