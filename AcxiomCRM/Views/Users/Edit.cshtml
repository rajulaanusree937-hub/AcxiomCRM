@model UserEditViewModel
@{
    ViewData["Title"] = "Edit User";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h1 class="h3 mb-0"><i class="bi bi-person-gear me-2"></i>Edit User</h1>
        <small class="text-muted">@Model.Email</small>
    </div>
    <a asp-action="Index" class="btn btn-outline-secondary btn-sm"><i class="bi bi-arrow-left"></i> Back to users</a>
</div>

<div class="row g-3">
    <div class="col-lg-8">
        <div class="card shadow-sm">
            <div class="card-body">
                <form asp-action="Edit" asp-route-id="@Model.Id" method="post" novalidate>
                    <input type="hidden" asp-for="Id" />
                    <input type="hidden" asp-for="Email" />
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3" role="alert"></div>

                    <div class="mb-3">
                        <label asp-for="FullName" class="form-label"></label> <span class="text-danger">*</span>
                        <input asp-for="FullName" class="form-control" maxlength="100" />
                        <span asp-validation-for="FullName" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Email (login)</label>
                        <input class="form-control" value="@Model.Email" disabled />
                    </div>

                    <div class="mb-3">
                        <label asp-for="Role" class="form-label"></label> <span class="text-danger">*</span>
                        <select asp-for="Role" class="form-select">
                            @foreach (var r in AppRoles.All)
                            {
                                <option value="@r">@r</option>
                            }
                        </select>
                        <span asp-validation-for="Role" class="text-danger small"></span>
                        <div class="form-text">Each user has exactly one role.</div>
                    </div>

                    <div class="form-check form-switch mb-1">
                        <input asp-for="IsActive" class="form-check-input" />
                        <label asp-for="IsActive" class="form-check-label"></label>
                    </div>
                    <span asp-validation-for="IsActive" class="text-danger small"></span>
                    <div class="form-text mb-3">Inactive users cannot log in.</div>

                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-primary"><i class="bi bi-check-lg"></i> Save changes</button>
                        <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <div class="col-lg-4">
        <div class="card shadow-sm">
            <div class="card-header bg-white fw-semibold"><i class="bi bi-shield-lock me-1"></i> Security</div>
            <div class="card-body">
                <dl class="mb-3">
                    <dt class="small text-muted">Lockout status</dt>
                    <dd>
                        @if (Model.IsLockedOut)
                        {
                            <span class="badge bg-danger">Locked until @Model.LockoutEnd?.ToLocalTime().ToString("dd MMM, hh:mm tt")</span>
                        }
                        else
                        {
                            <span class="badge bg-success">Not locked</span>
                        }
                    </dd>
                    <dt class="small text-muted">Failed login attempts</dt>
                    <dd class="mb-0">@Model.FailedLoginCount</dd>
                </dl>

                @if (Model.IsLockedOut)
                {
                    <form asp-action="Unlock" asp-route-id="@Model.Id" method="post" class="mb-2"
                          data-confirm="Unlock this account?">
                        <button type="submit" class="btn btn-outline-success w-100"><i class="bi bi-unlock"></i> Unlock account</button>
                    </form>
                }

                <a asp-action="ResetPassword" asp-route-id="@Model.Id" class="btn btn-outline-warning w-100">
                    <i class="bi bi-key"></i> Reset password
                </a>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}